        <item>
         <widget class="QGroupBox" name="transformSectionGroupBox">
          <property name="title">
           <string>2D Transformations</string>
          </property>
          <layout class="QVBoxLayout" name="transformSectionLayout">
           <item>
            <widget class="QLabel" name="transform_hint">
             <property name="text">
              <string>1) Click 3+ grid points  2) Draw Closed Polygon  3) Pick a transformation. a) to e) are about the origin (0, 0); f) uses the last line you drew (DDA / Bresenham) as the mirror line, and g) uses the last clicked cell as the pivot point. Press Reset Polygon first if you clicked other points earlier.</string>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="draw_polygon">
             <property name="minimumSize">
              <size>
               <width>0</width>
               <height>44</height>
              </size>
             </property>
             <property name="styleSheet">
              <string notr="true">QPushButton {
    background-color: rgb(200, 160, 255);
    color: black;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: rgb(165, 125, 220);
}</string>
             </property>
             <property name="text">
              <string>Draw Closed Polygon</string>
             </property>
            </widget>
           </item>
           <item>
            <widget class="QCheckBox" name="transform_chain_checkBox">
             <property name="toolTip">
              <string>Off: every transformation starts from the original polygon. On: it starts from the last transformed copy, so transformations can be combined step by step.</string>
             </property>
             <property name="text">
              <string>Chain: use previous result</string>
             </property>
            </widget>
           </item>
           <item>
            <layout class="QHBoxLayout" name="translateInputLayout">
             <item>
              <widget class="QSpinBox" name="translate_tx_spinBox">
